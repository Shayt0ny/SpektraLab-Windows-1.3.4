#version 450
// Local grade in encoded ProPhoto, before geometry and destination conversion.
layout(local_size_x=256)in;
layout(binding=0,std430)buffer Pixels{float v[];}img;
layout(binding=1,std430)readonly buffer Masks{float v[];}m;
layout(binding=2,std430)readonly buffer Rasters{float v[];}r;
layout(binding=3,std430)readonly buffer Meta{uint v[];}meta;
float smooth_range(float a,float b,float x){float t=clamp((x-a)/max(b-a,1e-6),0.0,1.0);return t*t*(3.0-2.0*t);}
float sample_raster(uint base,ivec2 p,ivec2 size){p=clamp(p,ivec2(0),size-1);return r.v[base+uint(p.y*size.x+p.x)];}
float coverage(uint b,vec2 uv){
    uint kind=uint(m.v[b]);float c=0.0,f=m.v[b+4u];vec2 a=vec2(m.v[b+5u],m.v[b+6u]),e=vec2(m.v[b+7u],m.v[b+8u]);
    if(kind==0u){vec2 d=e-a;float len=dot(d,d);if(len<1e-8)return 0.0;c=1.0-smooth_range((1.0-f)*0.5,(1.0+f)*0.5,dot(uv-a,d)/len);}
    else if(kind==1u){vec2 radius=max(abs(e-a),vec2(0.005));c=1.0-smooth_range(max(0.0,1.0-f),1.0,length((uv-a)/radius));}
    else{ivec2 size=ivec2(m.v[b+11u],m.v[b+12u]);vec2 p=uv*vec2(size)-0.5,frac=fract(p);ivec2 lo=ivec2(floor(p));uint base=uint(m.v[b+10u]);
        c=mix(mix(sample_raster(base,lo,size),sample_raster(base,lo+ivec2(1,0),size),frac.x),mix(sample_raster(base,lo+ivec2(0,1),size),sample_raster(base,lo+ivec2(1),size),frac.x),frac.y);}
    return clamp((m.v[b+3u]!=0.0?1.0-c:c)*m.v[b+2u],0.0,1.0);
}
float luma(vec3 c){return dot(c,vec3(.2126,.7152,.0722));}
vec3 grade(vec3 c,uint b){
    float t=m.v[b+20u]/100.0,g=m.v[b+21u]/100.0;c*=vec3(1.0+.18*t,1.0-.12*g,1.0-.18*t);
    float exposure=m.v[b+16u];if(exposure!=0.0)c=pow(pow(max(c,vec3(0)),vec3(2.2))*exp2(exposure),vec3(1.0/2.2));
    float contrast=m.v[b+17u]/100.0,brightness=m.v[b+18u]/100.0;
    if(contrast!=0.0)c=(c-.3857)*(1.0+contrast*1.2)+.3857;
    if(brightness!=0.0)c=pow(max(c,vec3(0)),vec3(1.0/(1.0+brightness*.8)));
    float y=luma(c),l=y<=.3857?.5*y/.3857:.5+.5*(y-.3857)/(1.0-.3857),sh=m.v[b+23u]/100.0,hi=m.v[b+22u]/100.0;
    if(sh!=0.0)c+=sh*.25*(1.0-l)*(1.0-l)*(1.0-c);
    if(hi!=0.0)c+=hi*.25*l*l*(hi>0.0?1.0-c:c);
    y=luma(c);c=y+(c-y)*(1.0+m.v[b+19u]/100.0);return clamp(c,0.0,1.0);
}
void main(){uint i=gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x;if(i>=meta.v[0])return;
    vec2 uv=(vec2(i%meta.v[1],i/meta.v[1])+.5)/vec2(meta.v[1],meta.v[2]);vec3 c=vec3(img.v[3u*i],img.v[3u*i+1u],img.v[3u*i+2u]);
    for(uint n=0u;n<meta.v[3];n++){uint b=n*32u;if(m.v[b+1u]==0.0)continue;float cover=coverage(b,uv);if(cover>0.0)c=mix(c,grade(c,b),cover);}
    c=floor(clamp(c,0.0,1.0)*65535.0+.5)/65535.0;img.v[3u*i]=c.r;img.v[3u*i+1u]=c.g;img.v[3u*i+2u]=c.b;
}
