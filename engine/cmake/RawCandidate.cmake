# Isolated candidate module: no LibRaw symbols are mixed into the stable host.
set(SPEKTRALAB_RAW_CANDIDATE_SOURCE "${SPEKTRALAB_DEPS_DIR}/redlamp-libraw-f4956c404fba0c6035ce9e06353d4b4ffe068fc7" CACHE PATH "Pinned optional RAW candidate source")
option(SPEKTRALAB_RAW_CANDIDATE "Build the isolated candidate RAW decoder" ON)
if(NOT SPEKTRALAB_RAW_CANDIDATE)
    return()
endif()
if(NOT EXISTS "${SPEKTRALAB_RAW_CANDIDATE_SOURCE}/REDLAMP.md")
    message(FATAL_ERROR "Run engine/setup-raw-candidate.py to obtain the pinned candidate source, or disable SPEKTRALAB_RAW_CANDIDATE")
endif()
file(GLOB_RECURSE candidate_sources CONFIGURE_DEPENDS "${SPEKTRALAB_RAW_CANDIDATE_SOURCE}/src/*.cpp")
list(FILTER candidate_sources EXCLUDE REGEX "/[^/]*_ph\\.cpp$")
include("${CMAKE_CURRENT_LIST_DIR}/CanonColorData.cmake")
spk_canon_colordata(candidate_sources "${SPEKTRALAB_RAW_CANDIDATE_SOURCE}" candidate)
add_library(spk_candidate_libraw STATIC ${candidate_sources})
target_include_directories(spk_candidate_libraw PUBLIC "${SPEKTRALAB_RAW_CANDIDATE_SOURCE}")
target_compile_definitions(spk_candidate_libraw PUBLIC LIBRAW_NODLL SPEKTRALAB_RAW_OPENMP=0)
target_compile_features(spk_candidate_libraw PUBLIC cxx_std_11)
set_target_properties(spk_candidate_libraw PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(spk_candidate_libraw PRIVATE -w)
endif()
if(WIN32)
    target_link_libraries(spk_candidate_libraw PUBLIC ws2_32)
endif()
add_library(spektralab-raw-candidate SHARED
    raw_candidate_module.cpp image_io.cpp input_formats.cpp lens_correction.cpp
    platform.cpp stb_impl.cpp tiff_ifd.cpp white_balance.cpp
    ../src/io/raw_decoder.cpp ../src/io/raw_headroom.cpp)
target_compile_definitions(spektralab-raw-candidate PRIVATE SPEKTRALAB_RAW_CANDIDATE_MODULE)
target_compile_features(spektralab-raw-candidate PRIVATE cxx_std_20)
target_include_directories(spektralab-raw-candidate PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/../src" "${CMAKE_CURRENT_SOURCE_DIR}/../third_party/stb")
target_link_libraries(spektralab-raw-candidate PRIVATE spk_candidate_libraw spektralab_core spk_codec_jpeg spk_codec_png spk_input_codecs spk_lens)
set_target_properties(spektralab-raw-candidate PROPERTIES PREFIX "" CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
if(WIN32)
    target_link_libraries(spektralab-raw-candidate PRIVATE shell32)
endif()
if(SPEKTRALAB_STATIC_RUNTIME AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_link_options(spektralab-raw-candidate PRIVATE -static-libstdc++ -static-libgcc)
    if(MINGW)
        target_link_options(spektralab-raw-candidate PRIVATE -static)
    endif()
endif()
if(UNIX AND NOT APPLE)
    target_link_options(spektralab-raw-candidate PRIVATE -Wl,-Bsymbolic)
endif()
add_dependencies(spektralab-host spektralab-raw-candidate)
